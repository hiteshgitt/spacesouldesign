# Copy to .env.local (dev) or set in your process manager (prod). Never commit real values.

# Canonical origin used for metadata, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://spaceandsouldesign.com

# "false" hides every amber placeholder marker and unconfirmed block.
# Leave unset (or "true") until the owner has supplied real content.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# ── Contact form delivery ────────────────────────────────────────────────
# Configure SMTP and/or a webhook. With neither set, /api/inquiry answers
# 503 "not-configured" and the form says so: it never fakes a success.

# SMTP (sent with nodemailer; port 465 uses TLS, anything else STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Mailbox that receives inquiries
INQUIRY_TO=
# Optional From header; defaults to "Space & Soul Design website" <SMTP_USER>
INQUIRY_FROM=

# Used only when SMTP is not configured: POSTs the validated inquiry as JSON
# (CRM, Slack, Zapier, Make…)
INQUIRY_WEBHOOK_URL=
